+    /// `crates/agent-nanocode/tests/code_mode_out_of_memory_defects.rs`). The
+    /// engine cannot tell such a runtime before dropping it.
+    fn renew(
+        self,
+        interrupted: &Arc<AtomicBool>,
+        budget: &Arc<CellBudget>,
+    ) -> Result<Self, String> {
+        drop(self);
+        Self::new(interrupted, budget)
+    }
+}
