# kata — operator-local secrets + runtime overrides
#
# Copy this file to `.env` (gitignored) and fill in real values. Both
# `just` recipes and direct kata / kata-worker invocations pick up `.env`
# automatically:
#
# - Every `just <recipe>` invocation: via `set dotenv-load := true`
#   at the top of the justfile.
# - Direct `./target/release/kata ...` and `kata-worker ...` invocations:
#   via `dotenvy` before CLI/config parsing.
#
# `dotenvy` searches the current working directory and walks up to
# the filesystem root — running from anywhere inside the kata repo
# (or from a subproject that puts a local `.env` next to its own
# root) works.
#
# Set `KATA_NO_DOTENV` in the launching process environment to suppress this
# ancestor search. The marker is presence-only (its value is ignored) and
# cannot be set here because Kata must decide whether to read `.env` first.
#
# `kata host setup` writes its own `KATA_EXTERNAL_*` provider settings into the
# project's `.env`; leave those lines as it wrote them.

# ────────────────────────────────────────────────────────────
# Agent credentials
# ────────────────────────────────────────────────────────────
# An agent that authenticates with an API key names the variable in its node
# config, never the key itself:
#
#   [agents.default]
#   credential = { mode = "api_key", source = "env:OPENAI_API_KEY" }
#
# Put the variable here. kata's own login (`kata login openai`, the
# `source = "kata_login"` an `[agents.<label>]` names) needs no entry: kata
# stores it in its own owner-only file (see README.md).
# OPENAI_API_KEY=<your key>

# ────────────────────────────────────────────────────────────
# kata runtime overrides
# ────────────────────────────────────────────────────────────
# All optional — uncomment to override defaults.

# Base URL of the installed main, read by `kata` operator commands
# (`--api-url`). Default: http://127.0.0.1:8400.
# KATA_API_URL=http://127.0.0.1:8400

# Bearer token for a token-protected API (`kata api-token`).
# KATA_API_TOKEN=<token>

# Where `kata-worker` writes its pidfile. Default: `$HOME/.kata/data`.
# KATA_DATA_DIR=/home/alice/.kata/data
