load("kata/std.star", "json_only")
load("kata/std.star", "memory_snapshot_stage")
load("kata/std.star", "shell_json_stage")
load("kata/std.star", "workspace_write_stage")
load("kata/std.star", "effect_stage")

instruction = json_only("{}")
m1 = memory_snapshot_stage(id = "memory_one")
m2 = memory_snapshot_stage(id = "memory_two")
s1 = shell_json_stage(id = "shell_one", run = "printf '{}'", outputs = {}, reads = "whole-tree")
s2 = shell_json_stage(id = "shell_two", run = "printf '{}'", outputs = {}, reads = ["src/**"])
w1 = workspace_write_stage(id = "write_one", run = "printf '{}'", outputs = {}, reads = "whole-tree")
w2 = workspace_write_stage(id = "write_two", run = "printf '{}'", outputs = {}, reads = ["src/**"], produces_files = ["out/**"])
e1 = effect_stage(id = "effect_one", op = "commit")
e2 = effect_stage(id = "effect_two", op = "commit")
workflow("std-conformance", root = [m1, m2, s1, s2, w1, w2, e1, e2])
