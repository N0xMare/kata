+
+// Reap every exited child without blocking. Returns the container init's
+// status once it has been reaped, or None while it is still running.
+fn reap_children(init_pid: Pid) -> Result<Option<i32>> {
+    loop {
+        match waitpid(None, Some(WaitPidFlag::WNOHANG))? {
+            WaitStatus::Exited(pid, status) => {
+                if pid.eq(&init_pid) {
+                    return Ok(Some(status));
+                }
+
+                // Else, some random child process exited, ignoring...
+            }
+            WaitStatus::Signaled(pid, signal, _) => {
+                if pid.eq(&init_pid) {
+                    return Ok(Some(signal as i32));
+                }
+
+                // Else, some random child process exited, ignoring...
+            }
+            WaitStatus::StillAlive => {
+                // No more child to reap.
+                return Ok(None);
+            }
+            _ => {}
+        }
+    }
+}
 
